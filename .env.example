# ==============================================================================
# PROJECT KEYSTONE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and provide your deployment-specific credentials.
# NEVER commit the actual .env file with secrets to version control.

# --- Platform & Gemini Integration ---
# Required for server-side Gemini AI operations & diagnostics
GEMINI_API_KEY=
# Application public URL (injected automatically in AI Studio / Cloud Run)
APP_URL=https://your-domain.keystone.io

# --- Database Credentials (PostgreSQL / Cloud SQL) ---
DATABASE_URL=postgresql://keystone_user:keystone_secure_password@localhost:5432/keystone_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=keystone_db
DATABASE_USERNAME=keystone_user
DATABASE_PASSWORD=keystone_secure_password

# --- Security, Authentication & Cryptography ---
# High-entropy HMAC-SHA256 secret key for signing Access and Refresh tokens
JWT_SECRET=replace_with_a_secure_random_256_bit_secret_key_in_production
# Access token expiration (e.g., 3600000 ms = 1 hour, or 86400000 ms = 24 hours)
JWT_EXPIRATION=3600000
JWT_EXPIRATION_MS=3600000
# Refresh token expiration (e.g., 604800000 ms = 7 days)
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Server & Networking Configuration ---
# HTTP Port (Must be 3000 in AI Studio / Cloud Run environment)
PORT=3000
# API Base URL for client and inter-service communication
API_BASE_URL=http://localhost:3000/api
# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Spring Boot Reference Backend Profile ---
SPRING_PROFILES_ACTIVE=dev
