rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Work Orders Collection (Dual storage with relational DB)
    match /work_orders/{workOrderId} {
      allow read, write: if true;
    }

    // Facilities / Sites Collection
    match /facilities/{facilityId} {
      allow read, write: if true;
    }

    // Assets Collection
    match /assets/{assetId} {
      allow read, write: if true;
    }

    // Technicians Collection
    match /technicians/{technicianId} {
      allow read, write: if true;
    }

    // Customers Collection
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Parts Catalog Collection
    match /parts/{partId} {
      allow read, write: if true;
    }

    // Facility Inventory Stock Collection
    match /facility_inventory/{invId} {
      allow read, write: if true;
    }

    // Labor Time Entries Collection
    match /time_entries/{timeEntryId} {
      allow read, write: if true;
    }

    // Service Requests Collection
    match /service_requests/{serviceRequestId} {
      allow read, write: if true;
    }

    // Audit Logs Collection (Immutable write-only ledger, read allowed)
    match /audit_logs/{auditLogId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Default match
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
